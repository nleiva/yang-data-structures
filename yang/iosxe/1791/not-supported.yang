  }

  deviation "/ios:native/ios:router/ios-bgp:bgp/ios-bgp:address-family/ios-bgp:no-vrf/ios-bgp:vpnv4" {
    deviate not-supported;
  }

  deviation "/ios:native/ios:router/ios-bgp:bgp/ios-bgp:address-family/ios-bgp:no-vrf/ios-bgp:nsap" {
    deviate not-supported;
  } 

  deviation "/ios:native/ios:router/ios-bgp:bgp/ios-bgp:address-family/ios-bgp:no-vrf/ios-bgp:link-state" {
    deviate not-supported;
  }

  deviation "/ios:native/ios:router/ios-bgp:bgp/ios-bgp:address-family/ios-bgp:no-vrf/ios-bgp:rtfilter" {
    deviate not-supported;
  }

  deviation "/ios:native/ios:router/ios-bgp:bgp/ios-bgp:address-family/ios-bgp:no-vrf/ios-bgp:l2vpn" {
    deviate not-supported;
  }

  deviation "/ios:native/ios:router/ios-bgp:bgp/ios-bgp:address-family/ios-bgp:no-vrf/ios-bgp:ipv6" {
    deviate not-supported;
  }

  deviation "/ios:native/ios:router/ios-bgp:bgp/ios-bgp:address-family/ios-bgp:no-vrf/ios-bgp:vpnv6" {
    deviate not-supported;
  } 

  //============================= IP ==================================
  // deviation "/ios:native/ios:ip/ios:domain/ios:lookup-settings/" {
  //   deviate not-supported;
  // }   

  //============================= NAT ==================================
  deviation "/ios:native/ios:nat64" {
    deviate not-supported;
  }

  deviation "/ios:native/ios:nat66" {
    deviate not-supported;
  }  

  //============================= Object Group ==================================
  deviation "/ios:native/ios:object-group" {
    deviate not-supported;
  }

  //============================= ACL ==================================
  deviation "/ios:native/ios:ipv6/ios:access-list" {
    deviate not-supported;
  }

  //============================= IPv6 ==================================
  deviation "/ios:native/ios:ipv6" {
    deviate not-supported;
  }  
}